{
  "name": "portavate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @portavate/api --filter @portavate/verifier --filter @portavate/web dev",
    "build": "pnpm typecheck && pnpm --filter @portavate/web build",
    "typecheck": "pnpm --filter @portavate/web exec next typegen && tsc --noEmit && pnpm --filter @portavate/web typecheck",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.50.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "@portavate/shared": "workspace:*",
    "@portavate/memory-core": "workspace:*",
    "@portavate/crypto": "workspace:*",
    "@portavate/verification": "workspace:*",
    "@portavate/api": "workspace:*",
    "@portavate/verifier": "workspace:*"
  }
}
